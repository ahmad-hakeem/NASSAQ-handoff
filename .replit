modules = ["python-base-3.12", "nodejs-22", "postgresql-16"]

  [agent]
expertMode = true
  integrations = ["python_openai_ai_integrations:1.0.0"]

  [nix]
  channel = "stable-25_05"
packages = ["cargo", "freetype", "glibcLocales", "lcms2", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "openssl", "pkg-config", "postgresql", "rustc", "tcl", "tk", "xcodebuild", "zlib"]

  [workflows]
runButton = "Project"

  [[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend Dev"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "fe-build"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "fe-test-continue"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "backend-gate"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "frontend-gate"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-gate"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ci-backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ci-frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ci-e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ci-security"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ci-all"

  [[workflows.workflow]]
name = "Backend API"
author = "agent"

  [workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && uvicorn server:app --host 0.0.0.0 --port 8000"
waitForPort = 8000

[[workflows.workflow]]
name = "Frontend Dev"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && PORT=5000 BROWSER=none npx craco start"
waitForPort = 5000

[[workflows.workflow]]
name = "fe-build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && CI=false npm run build"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "fe-test-continue"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && CI=true npx react-scripts test --watchAll=false --testPathPattern='SessionsManageTab.continueSession'"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "backend-gate"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/ci/run_backend_gate_local.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "frontend-gate"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/ci/frontend_tests.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "e2e-gate"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/ci/run_e2e_gate_local.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "ci-backend"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/ci/run_gate_local.sh backend"

[[workflows.workflow]]
name = "ci-frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/ci/run_gate_local.sh frontend"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "ci-e2e"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/ci/run_gate_local.sh e2e"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "ci-security"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/ci/run_gate_local.sh security"

[[workflows.workflow]]
name = "ci-all"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/ci/run_gate_local.sh all"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 5055
externalPort = 3002

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8100
externalPort = 3001

[[ports]]
localPort = 23636
externalPort = 80

  [deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd /home/runner/workspace/backend && source /home/runner/workspace/.venv/bin/activate && uvicorn server:app --host 0.0.0.0 --port ${PORT:-8000}"]
build = ["bash", "/home/runner/workspace/build.sh"]

  [userenv]

  [userenv.production]
  CORS_ORIGINS = "https://nassaq.com,https://www.nassaq.com"
FRONTEND_URL = "https://nassaq.com"

  [userenv.development]
CORS_ORIGINS = "https://76d3d322-060b-41e8-b1b6-757b9374d907-00-uqpmfo0lufwh.worf.replit.dev,https://nassaq.com,https://www.nassaq.com"
FRONTEND_URL = "https://76d3d322-060b-41e8-b1b6-757b9374d907-00-uqpmfo0lufwh.worf.replit.dev"

  [userenv.shared]
ENVIRONMENT = "production"
MFA_ENFORCEMENT_DISABLED = "true"
APP_URL = "https://nassaqapp.com"

  [objectStorage]
defaultBucketID = "replit-objstore-74e91ecd-87d7-4ff2-a2ad-91e1fdc9c773"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
  