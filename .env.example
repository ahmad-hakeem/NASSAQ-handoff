# ===== NASSAQ Docker deployment configuration =====
# Copy to .env and fill in every required value before `docker compose up`.

# --- Database (required) ---
# Password for the bundled Postgres container. The app's DATABASE_URL is
# derived from this automatically in docker-compose.yml.
POSTGRES_PASSWORD=

# --- Security secrets (required) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# --- Web origin (required in production) ---
# The exact URL users will open in their browser. Production REFUSES to boot
# with a wildcard. Comma-separate multiple origins if needed.
# Examples: https://nassaq.example.com   or   http://192.168.1.50:8000
CORS_ORIGINS=
# Hostnames the server accepts (comma-separated). "*" is allowed here.
ALLOWED_HOSTS=*

# --- Runtime mode ---
# "production" blocks seed scripts and destructive DB operations.
# For the FIRST boot on an empty database, set this to "development" together
# with the ADMIN_SEED_PASSWORD_* values below so the initial platform-admin
# accounts are created, then switch back to "production" and restart.
ENVIRONMENT=production

# --- First-boot admin bootstrap (only used when ENVIRONMENT=development and DB is empty) ---
ADMIN_SEED_PASSWORD_ZALAT=
ADMIN_SEED_PASSWORD_HAKIM=

# --- AI features (optional; Hakim assistant & AI insights are disabled if unset) ---
# For direct OpenAI: AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# --- Host port the app is exposed on ---
APP_PORT=8000
